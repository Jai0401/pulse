# Frontend (Vite)
VITE_API_URL=http://localhost:3001

# Backend (Express)
PORT=3001
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Authentication for YouTube bot-check bypass
# Option A (recommended for local dev): read cookies directly from your browser
# Supported values: chrome, firefox, safari, edge, chromium, opera, vivaldi
COOKIES_FROM_BROWSER=chrome

# Option B (for Docker/cloud): path to an exported cookies.txt file
# COOKIES_PATH=/path/to/cookies.txt
